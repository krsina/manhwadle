# Supabase (browser — publishable/anon only)
# Dashboard → Project Settings → API Keys. Copy the anon or publishable key.
# Auth redirects: Dashboard → Authentication → URL Configuration
#   Site URL: http://localhost:5173 (local) or production origin (hosted)
#   Redirect URLs (staging + production projects):
#     http://localhost:5173/**
#     https://*.pages.dev/**          # Cloudflare Pages previews + *.pages.dev
#     https://<your-production-domain>/**
# Pages Preview env vars must point at a staging Supabase project — see docs/deployment.md
#
# Social login (Google / Discord): Dashboard → Authentication → Providers
#   Enable each provider and paste Client ID + Secret from the provider console.
#   Google: https://console.cloud.google.com/apis/credentials
#     Authorized redirect URI = Supabase callback shown in the provider panel
#     (https://<project-ref>.supabase.co/auth/v1/callback)
#   Discord: https://discord.com/developers/applications → OAuth2
#     Same Supabase callback URI as Redirects
# Docs: https://supabase.com/docs/guides/auth/social-login
VITE_SUPABASE_URL=https://snzhnkcccbxkwerbaido.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only (scripts, Edge Functions) — never expose to Vite / browser
# SUPABASE_URL=https://snzhnkcccbxkwerbaido.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
#
# Edge Function `account-data` (export + self-service delete):
#   Deploy: supabase functions deploy account-data
#   Runtime uses SUPABASE_URL + SUPABASE_ANON_KEY (or publishable) + SUPABASE_SERVICE_ROLE_KEY
#   (auto-injected on hosted Supabase). verify_jwt = true in supabase/config.toml.
#   Client calls with the signed-in user JWT; the function derives user id from the JWT
#   and rejects body user_id / actor_id. See docs/account-data.md
#
# Edge Function `moderation` (owner/moderator actions):
#   Deploy: supabase functions deploy moderation
#   Actor id is derived from the caller JWT only — never pass actor_id / user_id from the client.
#   See docs/moderation.md (owner bootstrap, CAPTCHA/rate limits, Auth hook).
#
# Edge Function `select-daily-puzzles` (cron / service only):
#   Deploy: supabase functions deploy select-daily-puzzles
#   verify_jwt = false (custom CRON_SECRET or service-role bearer inside the function).
#   Set CRON_SECRET as a hosted function secret; do not put it in Vite / Pages.
#   See docs/runbooks/daily-puzzles.md and docs/deployment.md
#
# Browser CORS allowlist for moderation + account-data (hosted Edge Function secret):
#   Comma-separated origins, e.g. https://manhwadle.com,https://*.pages.dev
#   Unset locally → http://localhost:5173 and http://127.0.0.1:5173 only (no *).
# CORS_ALLOWED_ORIGINS=
# CRON_SECRET=
# SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Adversarial security smoke (staging / local ONLY — never production)
# See docs/runbooks/security-negatives-staging.md
# npm run test:live:security
#
# Fail-closed: both target + acknowledgment required. Credentials must use
# STAGING_* (or SECURITY_SMOKE_*) names — the script ignores VITE_/production keys.
# SECURITY_SMOKE_TARGET=staging
# SECURITY_SMOKE_ACK_NON_PRODUCTION=I_UNDERSTAND_STAGING_ONLY
# STAGING_SUPABASE_URL=https://<staging-ref>.supabase.co
# STAGING_SUPABASE_SERVICE_ROLE_KEY=
# STAGING_SUPABASE_ANON_KEY=
# Optional extra denylist (comma-separated project refs); production ref is always blocked:
# SECURITY_SMOKE_PRODUCTION_REF_DENYLIST=

# ---------------------------------------------------------------------------
# Display ads (optional — fully no-op when unset / disabled)
# See docs/ads.md
#
# VITE_ADS_ENABLED=true
# VITE_ADS_PROVIDER=adsense
#
# AdSense (primary)
# VITE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxx
# VITE_ADSENSE_RAIL_LEFT_SLOT=
# VITE_ADSENSE_RAIL_LEFT_WIDTH=160
# VITE_ADSENSE_RAIL_LEFT_HEIGHT=600
# VITE_ADSENSE_RAIL_RIGHT_SLOT=
# VITE_ADSENSE_RAIL_RIGHT_WIDTH=160
# VITE_ADSENSE_RAIL_RIGHT_HEIGHT=600
# VITE_ADSENSE_BOTTOM_SLOT=
# VITE_ADSENSE_BOTTOM_WIDTH=728
# VITE_ADSENSE_BOTTOM_HEIGHT=90
#
# Adsterra (fallback display + rewarded)
# VITE_ADSTERRA_INVOKE_HOST=www.highperformanceformat.com
# VITE_ADSTERRA_RAIL_LEFT_KEY=
# VITE_ADSTERRA_RAIL_RIGHT_KEY=
# VITE_ADSTERRA_BOTTOM_KEY=
# VITE_ADSTERRA_REWARDED_KEY=
# VITE_REWARDED_AD_POINTS=15
#
# After network signup, paste authorized seller lines into public/ads.txt

# Optional privacy-safe error monitoring (Sentry). Leave unset to stay console-only.
# No session replay / PII. Only loads when DSN is present.
# On Cloudflare Pages, set Production vs Preview separately (docs/deployment.md):
#   Production: VITE_SENTRY_ENVIRONMENT=production
#   Preview:    VITE_SENTRY_ENVIRONMENT=preview
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
