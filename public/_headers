/*
  # X-Frame-Options omitted on purpose: DENY/SAMEORIGIN cannot allow AdSense's
  # ads preview iframe. Clickjacking is controlled via CSP frame-ancestors below.
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  #
  # Content-Security-Policy notes:
  # - script-src includes 'unsafe-inline' ONLY for the tiny theme boot in index.html
  #   (localStorage theme → data-theme) and Adsterra banner srcdoc bootstraps.
  # - No 'unsafe-eval'.
  # - Supabase Auth/API, PostHog EU, Cloudflare beacon, Google Fonts, AniList media,
  #   YouTube Heardle embeds, AdSense, and Adsterra banner CDNs are allowlisted.
  # - img-src / frame-src allow https: so third-party display creatives can load.
  # - frame-ancestors allows Google AdSense ads preview (and related Google frames)
  #   while still blocking arbitrary third-party embedding.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://*.google.com https://*.googleusercontent.com https://*.doubleclick.net https://*.googlesyndication.com; form-action 'self' https://*.supabase.co; img-src 'self' data: blob: https:; media-src 'self' blob: https://*.supabase.co; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.youtube.com https://www.youtube-nocookie.com https://eu.i.posthog.com https://eu-assets.i.posthog.com https://pagead2.googlesyndication.com https://www.googletagservices.com https://www.google.com https://www.gstatic.com https://partner.googleadservices.com https://www.highperformanceformat.com https://www.profitablecreativeformat.com https://www.effectivecreativeformat.com https://*.adsterra.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://eu.i.posthog.com https://eu-assets.i.posthog.com https://static.cloudflareinsights.com https://cloudflareinsights.com https://s4.anilist.co https://img.anili.st https://*.anilist.co https://www.youtube.com https://www.youtube-nocookie.com https://i.ytimg.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.google.com https://www.highperformanceformat.com https://www.profitablecreativeformat.com https://www.effectivecreativeformat.com https://*.adsterra.com; frame-src https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: index, follow

/staff/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/ads.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
