{
  "name": "manhwadle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:tools": "vite --config vite.tools.config.ts",
    "library": "vite --config vite.tools.config.ts --open /library.html",
    "review:images": "node scripts/build-character-image-review.mjs && vite --config vite.tools.config.ts --open /character-images.html",
    "verify:images": "python scripts/generate_character_image_report.py && python scripts/serve_character_image_verify.py",
    "build:catalog": "node scripts/build-client-catalog.mjs",
    "build": "npm run build:catalog && tsc -b && vite build",
    "build:tools": "vite build --config vite.tools.config.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "node scripts/smoke-supabase.mjs",
    "test:live:auth": "node scripts/smoke-auth-sync.mjs",
    "test:live:news": "node scripts/smoke-news-comments.mjs",
    "test:live:multiplayer": "node scripts/smoke-multiplayer.mjs",
    "test:live:multiplayer:security": "node scripts/smoke-multiplayer-security.mjs",
    "test:live:security": "node scripts/smoke-security-negatives.mjs",
    "check:dist": "node scripts/check-dist-artifacts.mjs",
    "check:contact": "node scripts/check-contact-configured.mjs",
    "check:migrations": "node scripts/check-migration-timestamps.mjs",
    "check:migration-drift": "node scripts/check-migration-drift.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "preflight": "node scripts/preflight.mjs",
    "preview": "vite preview",
    "fetch-data": "node scripts/fetch-manhwa.mjs",
    "sync-data": "node scripts/sync-game-data.mjs && node scripts/build-protagonists.mjs",
    "build-protagonists": "node scripts/build-protagonists.mjs",
    "sync-pools": "node scripts/sync-puzzle-pools.mjs",
    "backup:local": "node scripts/mirror-local-backup.mjs",
    "etl:fetch": "npm --prefix manhwadle-etl run fetch",
    "etl:fetch:reset": "npm --prefix manhwadle-etl run fetch:reset",
    "etl:fetch:relations": "npm --prefix manhwadle-etl run fetch:relations",
    "etl:export:top": "node scripts/etl-export-top.mjs",
    "etl:export:top500": "node scripts/etl-export-top.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
